# /etc/retro/env — EnvironmentFile для retro.service (systemd).
# Копия шаблона: deploy/env.example. Файл с секретами, в git не коммитить.

# Telegram (обязательно в проде; без BOT_TOKEN сервер стартует в dev-режиме)
BOT_TOKEN=1234567890:AAAbbbCCCdddEEEfffGGGhhhIIIjjjKKK
# Случайная строка: защита POST /bot (Telegram шлёт её в заголовке
# x-telegram-bot-api-secret-token). Сгенерировать: openssl rand -hex 32
BOT_WEBHOOK_SECRET=

# Публичный адрес сервера: Mini App URL + target webhook Telegram
PUBLIC_URL=https://retro.example.com
# Логин бота без @ (t.me/<username>)
BOT_USERNAME=
# Короткое имя Mini App для прямой ссылки t.me/<bot>/<short>
APP_SHORT_NAME=app

# Локальные (nginx проксирует на 127.0.0.1:PORT)
PORT=8787
# SQLite: сессии/игроки/ответы. Каталог должен существовать и быть
# доступен пользователю retro (unit: ReadWritePaths=/var/lib/retro)
DB_PATH=/var/lib/retro/retro.db

# Как долго живает нетронутая сессия до сборки мусора (часы)
# SESSION_TTL_HOURS=24
