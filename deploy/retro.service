[Unit]
Description=Retro online mode (Bun + WebSocket + sqlite)
Documentation=https://github.com/beCharlatan/retro
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=retro
Group=retro
WorkingDirectory=/opt/retro/server
EnvironmentFile=/etc/retro/env
ExecStart=/home/retro/.bun/bin/bun /opt/retro/server/index.js
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/retro

[Install]
WantedBy=multi-user.target
